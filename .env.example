# B-G1' local dev site — copy to .env and edit secrets.
# `cp .env.example .env` — .env is gitignored; never commit real secrets.

COMPOSE_PROJECT_NAME=ewcp-erp-dev

# --- images ---
# Docker Hub may be rate-limited on shared egress; mirror.gcr.io is a
# read-through cache of docker.io and is the verified source used for the
# 2026-10-09 smoke run. Swap to the upstream names if your network is fine.
ERPNEXT_IMAGE=mirror.gcr.io/frappe/erpnext:v16.50.0   # upstream: frappe/erpnext:v16.50.0
MARIADB_IMAGE=mirror.gcr.io/library/mariadb:11.8       # upstream: mariadb:11.8
REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine       # upstream: redis:7-alpine

# --- site ---
SITE_NAME=ewcp-dev.localhost
HTTP_PORT=8080                  # frontend binds 127.0.0.1:<HTTP_PORT>

# --- secrets (generated values for LOCAL DEV ONLY; never commit) ---
DB_ROOT_PASSWORD=dev-local-only-db-root
ADMIN_PASSWORD=dev-local-only-admin
