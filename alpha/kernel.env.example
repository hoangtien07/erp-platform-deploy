# EWCP kernel — Alpha profile env (copy to alpha/kernel.env, gitignored).
# Real values come from the deployer's secret store. NOTHING sensitive
# belongs in this committed template — placeholders only.

# Boot posture
EWCP_REQUIRE_AUTH=1                    # refuse to serve without EWCP_SEAL_KEY
EWCP_TENANT_KEYS='__MINT_PER_DEPLOY__' # 'key:tenant' CSV, e.g. 'k-alice:tenant-a'
EWCP_SEAL_KEY=__FROM_SECRET_STORE__    # manifest seal key
EWCP_SEAL_KEY_ID=alpha-1

# Data dirs
EWCP_STORE_DIR=var/ewcp
EWCP_WORK_DIR=var/work

# C05 — external writes: leave UNSET/EMPTY. Every external-write outcome
# (e.g. erp_write_po) then answers 404 until the founder allowlists it.
EWCP_EXTERNAL_WRITE_ALLOWLIST=

# Auto-accept stays OFF — do not export EWCP_AUTO_ACCEPT_VERIFIED.
