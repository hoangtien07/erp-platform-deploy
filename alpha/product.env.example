# EWCP product gateway — Alpha profile env (copy to alpha/product.env,
# gitignored). Real values come from the deployer's secret store —
# placeholders only.

# Auth: DEER_FLOW_AUTH_DISABLED stays ABSENT — its absence is the knob
# that keeps local/OIDC auth on. CSRF double-submit middleware is
# always-on; pin allowed origins to the deployment surface:
GATEWAY_CORS_ORIGINS=http://127.0.0.1:2026

# Kernel wiring (env beats the plugin `config:` block in config.yaml)
EWCP_KERNEL_URL=http://127.0.0.1:8000
EWCP_KERNEL_API_KEY=__FROM_SECRET_STORE__

# Egress (env-first overrides; config.yaml plugins.ewcp_core.config.egress
# is the committed baseline — env wins at runtime)
EWCP_EGRESS_DEFAULT_MODE=local_only
# EWCP_EGRESS_TENANT_MODES='{"tenant-a":"local_only"}'
# EWCP_TENANT_DATA_CLASS='{"tenant-a":"sensitive"}'
# EWCP_EGRESS_LOCAL_MODEL_ENDPOINTS='["http://127.0.0.1:11434"]'

# Model provider key — referenced by models[0].api_key in config.yaml
GEMINI_API_KEY=__FROM_SECRET_STORE__
